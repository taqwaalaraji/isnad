# Web settings (names only). `make env` writes web/.env.local for local development; in
# production they come from deploy/.env through deploy/docker-compose.yml.

# Browser-visible (also compiled into the client bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Server only
SUPABASE_SECRET_KEY=
SITE_URL=
WORKER_API_URL=
INTERNAL_API_TOKEN=
