# Worker settings (names only). `make env` writes worker/.env for local development from the
# running local Supabase and ../credentials; production values come from deploy/.env.

# Database and Supabase (the secret key bypasses row-level security: server only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public URL of the web app (links in Telegram replies and alerts)
SITE_URL=
# Shared secret for web → worker API calls
INTERNAL_API_TOKEN=

# Gemini API key (every model task, transcription included)
GEMINI_API_KEY=

# Telegram: polling in development, webhook in production, or off
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Worker behaviour
WORKER_CONCURRENCY=
POLL_INTERVAL_SECONDS=
JOB_TIMEOUT_MINUTES=
DISCOVERY_ENABLED=
DISCOVERY_PER_CHECK=
WATCH_INTERVAL_HOURS=

# Test corpus folder (default: sample-data/ in the repository) for `make corpus` and `make eval`
ISNAD_CORPUS_DIR=
