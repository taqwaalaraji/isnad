# Your API keys for local development. `make env` creates credentials.env (git-ignored) from this
# file the first time; fill in the keys there, then run `make env` again to copy them into
# worker/.env. A key left empty is simply not used.

# Gemini API key, from Google AI Studio → API keys: every model task (transcription, extraction,
# source search, verification, Ask Isnad, briefs). Viewing the demo data works without it.
GEMINI_API_KEY=

# Telegram bot token, from @BotFather → /newbot (optional): the Telegram bot. Use a bot made for
# development, not the production one.
TELEGRAM_BOT_TOKEN=
