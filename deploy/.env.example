# Isnad production settings. Copy to deploy/.env (never commit it) and fill in every value.
# The Supabase values must be the same ones in the Supabase stack's own .env.

# ── Domains and TLS ───────────────────────────────────────────────────────────
SITE_DOMAIN=
SUPABASE_DOMAIN=
ACME_EMAIL=

# ── Supabase (from the Supabase stack's .env) ─────────────────────────────────
POSTGRES_PASSWORD=
# The anon key is the browser's publishable key; the service-role key is the server's secret key.
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_NETWORK=supabase_default

# ── Shared secret between the web app and the worker API ─────────────────────
INTERNAL_API_TOKEN=

# ── Gemini API (every model task, transcription included) ─────────────────────
# A Google AI Studio key on a project with billing enabled.
GEMINI_API_KEY=

# ── Telegram (production bot) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Worker tuning (optional) ──────────────────────────────────────────────────
WORKER_CONCURRENCY=4
JOB_TIMEOUT_MINUTES=30
DISCOVERY_ENABLED=true
WATCH_INTERVAL_HOURS=24

# ── Image tag ─────────────────────────────────────────────────────────────────
ISNAD_VERSION=latest
